  "incidents": [
    {
      "id": "01M5WA55T284S335ZTE9MN8MWZ",
      "name": "Degraded networking to AWS IPs",
      "status": "identified",
      "created_at": "2026-10-26T14:34:43Z",
      "updated_at": "2026-10-26T16:26:19Z",
      "impact": "none",
      "page_id": "01KZSP42XPW71QZVJ4J2E597HE",
      "incident_updates": [
        {
          "id": "01M5WGHG8NBAD3AFVE9TWX6C1C",
          "body": "We are continuing to work with our upstream networking partners and AWS on remediation. Impacted customers are recommended to allocate app-scoped static egress IPs using **fly ips allocate-egress.** \n\nCustomers seeing issues are encouraged to also contact AWS support or their AWS hosted vendors support with details of the connection errors and their fly machine IPs.",
          "created_at": "2026-10-26T16:26:19Z",
          "display_at": "2026-10-26T16:26:19Z",
          "incident_id": "01M5WA55T284S335ZTE9MN8MWZ",
          "status": "identified",
          "updated_at": "2026-10-26T16:26:19Z"
        },
        {
          "id": "01M5WCFT515JERAXPWF26K8WBR",
          "body": "We are continuing to see connectivity issues from AWS IPs to a subset of our hosts. From our investigation these connections appear to be being blocked from the AWS side. We are continuing to work with our upstream networking partners and AWS on remediation.\n\nIn the meantime impacted customers are recommended to allocate app-scoped static egress IPs using **fly ips allocate-egress.** ",
          "created_at": "2026-10-26T15:15:29Z",
          "display_at": "2026-10-26T15:15:29Z",
          "incident_id": "01M5WA55T284S335ZTE9MN8MWZ",
          "status": "identified",
          "updated_at": "2026-10-26T15:15:29Z"
        },
        {
          "id": "01M5WB8V8MN66D8AC17SV1GKK4",
          "body": "Our initial investigations indicate connection errors are occuring the return path from AWS IPs. We are escalating the issue with AWS and continuing to investigate. \n\nCustomers seeing issues are encouraged to also contact AWS support or their AWS hosted vendors support with details of the connection errors and their fly machine IPs.",
          "created_at": "2026-10-26T14:54:12Z",
          "display_at": "2026-10-26T14:54:12Z",
          "incident_id": "01M5WA55T284S335ZTE9MN8MWZ",
          "status": "investigating",
          "updated_at": "2026-10-26T14:54:12Z"
        },
        {
          "id": "01M5WA55T2WP9XY5PK25J8WEV9",
          "body": "We are investigating reports of elevated networking issues between our network and AWS IPs. We are working to determine the source of the issue.\n\n ",
          "created_at": "2026-10-26T14:34:43Z",
          "display_at": "2026-10-26T14:34:43Z",
          "incident_id": "01M5WA55T284S335ZTE9MN8MWZ",
          "status": "investigating",
          "updated_at": "2026-10-26T14:34:43Z"
        }
      ]
    }
  ],
