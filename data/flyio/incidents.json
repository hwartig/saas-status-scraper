    {
      "id": "01M52YDPQA7DB00ZB4KVCWXWF8",
      "name": "Fly-metrics.net Grafana Dashboard Outage",
      "status": "identified",
      "created_at": "2026-10-16T18:08:39Z",
      "updated_at": "2026-10-16T18:08:39Z",
      "impact": "major",
      "page_id": "01KZSP42XPW71QZVJ4J2E597HE",
      "incident_updates": [
        {
          "id": "01M52YDPQAHG8X9BJJW18SQTV3",
          "body": "The fly-metrics.net hosted grafana and log search instance is currently unreachable as a result of <https://status.flyio.net/incidents/01M52RAWMVC0NKEBRDKC3VXT3K>. It will return once the host it is on is out of maintenance, approximately 20 minutes.\n\nLogs and Metrics shipped to other sources using things like Fly Telemetry or the Fly Log shipper continue to be available, only the hosted Grafana viewer is unavailable at this time. ",
          "created_at": "2026-10-16T18:08:39Z",
          "display_at": "2026-10-16T18:08:39Z",
          "incident_id": "01M52YDPQA7DB00ZB4KVCWXWF8",
          "status": "identified",
          "updated_at": "2026-10-16T18:08:39Z"
        }
      ]
    },
    {
      "id": "01M52RAWMVC0NKEBRDKC3VXT3K",
      "name": "Platform Wide Rolling Host Reboots",
      "status": "identified",
      "created_at": "2026-10-16T16:22:15Z",
      "updated_at": "2026-10-16T18:01:30Z",
      "impact": "major",
      "page_id": "01KZSP42XPW71QZVJ4J2E597HE",
      "incident_updates": [
        {
          "id": "01M52Y0KNRV366TYQ7M60SJPQC",
          "body": "Host restarts are continuing in phases across all regions. Only a subset of hosts in each region will be down at each time. We expect this process to take multiple hours to complete in full, with larger regions taking the longest to complete. \n\nRollout phases were scheduled to minimize impact to Managed Postgres Clusters within those regions, however MPG users will likely see elevated primary <> standby switchovers during this period. \n\nWe will provide further updates on progress as the rollout continues.",
          "created_at": "2026-10-16T18:01:30Z",
          "display_at": "2026-10-16T18:01:30Z",
          "incident_id": "01M52RAWMVC0NKEBRDKC3VXT3K",
          "status": "identified",
          "updated_at": "2026-10-16T18:01:30Z"
        },
        {
          "id": "01M52TFGHB8V8M8FAGDGJKXSBY",
          "body": "Rolling host restarts are beginning in all regions. \n\nMachines, volumes, and MPG instances will be unavailable for approximately 15-20 minutes when their hosts are restarted during this process.\n\nUsers should expect a period of disruption or downtime for their apps during this, especially if they are running on a single machine.\n\nWe will provide further updates as the rollout progresses. ",
          "created_at": "2026-10-16T16:59:44Z",
          "display_at": "2026-10-16T16:59:44Z",
          "incident_id": "01M52RAWMVC0NKEBRDKC3VXT3K",
          "status": "identified",
          "updated_at": "2026-10-16T16:59:44Z"
        },
        {
          "id": "01M52SY0FKPTAHCCM6WW3Z6DDB",
          "body": "We are beginning the rolling restart process of all hosts, beginning with the YYZ region. Machines, volumes, and MPG instances on hosts being rebooted will be unavailable for approximately 15-20 minutes during the restart.\n\nWe will provide further updates as the rollout progresses.",
          "created_at": "2026-10-16T16:50:11Z",
          "display_at": "2026-10-16T16:50:11Z",
          "incident_id": "01M52RAWMVC0NKEBRDKC3VXT3K",
          "status": "identified",
          "updated_at": "2026-10-16T16:50:11Z"
        },
        {
          "id": "01M52RAWMVT5XTH244AG8NSYB8",
          "body": "We will be imminently applying rolling restarts across all hosts in our fleet for a critical maintenance. Customer Machines, volumes, and MPG cluster instances on each host will be unavailable while their host reboots.\n\nEach host will be unavailable for 15 - 20 minutes during the restart, and multiple hosts in a region may be down at once. Users should expect a period of downtime or disruption for their apps, especially if they are running on a single machine.\n\nWe are aiming for the highest possible uptime during the rollout, while ensuring this is completed quickly.\n\nWe will provide a further update once we begin the restart process.",
          "created_at": "2026-10-16T16:22:16Z",
          "display_at": "2026-10-16T16:22:15Z",
          "incident_id": "01M52RAWMVC0NKEBRDKC3VXT3K",
          "status": "identified",
          "updated_at": "2026-10-16T16:22:16Z"
        }
      ]
    },
    {
      "id": "01M4ZEBB8WHB9A0PMEG93GPFQZ",
      "name": "Elevated errors creating apps and managing secrets",
      "status": "resolved",
      "created_at": "2026-10-15T09:30:01Z",
      "updated_at": "2026-10-15T11:33:46Z",
      "resolved_at": "2026-10-15T11:33:46Z",
      "impact": "minor",
      "page_id": "01KZSP42XPW71QZVJ4J2E597HE",
      "incident_updates": [
        {
          "id": "01M4ZNDY91P6JVGB69A40R4D2K",
          "body": "Between 06:40 and 09:50 UTC some app creation and secrets requests failed or timed out. Running apps and Machines were not affected.",
          "created_at": "2026-10-15T11:33:46Z",
          "display_at": "2026-10-15T11:33:46Z",
          "incident_id": "01M4ZEBB8WHB9A0PMEG93GPFQZ",
          "status": "resolved",
          "updated_at": "2026-10-15T11:33:46Z"
        },
        {
          "id": "01M4ZFXA86B9YVPRN7VHMAYV0R",
          "body": "We’ve applied a fix for the elevated errors affecting app creation and secrets management. Error rates and response times have returned to normal. We’re continuing to monitor to confirm the issue is fully resolved.",
          "created_at": "2026-10-15T09:57:19Z",
          "display_at": "2026-10-15T09:57:19Z",
          "incident_id": "01M4ZEBB8WHB9A0PMEG93GPFQZ",
          "status": "monitoring",
          "updated_at": "2026-10-15T09:57:19Z"
        },
        {
          "id": "01M4ZEBB8WHMVNET9NCG1GK9TR",
          "body": "We’re seeing elevated error rates and slow responses for some operations that create or change data. Creating new apps, setting or removing secrets, and some app deletions are affected. You may see 500 or 503 errors from `flyctl`, the Machines API, or the dashboard.\n\nApps and Machines that are already running are not affected. Starting, stopping and reading existing Machines are working normally. We’re investigating and will post another update within 30 minutes.",
          "created_at": "2026-10-15T09:30:01Z",
          "display_at": "2026-10-15T09:30:01Z",
          "incident_id": "01M4ZEBB8WHB9A0PMEG93GPFQZ",
          "status": "investigating",
          "updated_at": "2026-10-15T09:30:01Z"
        }
      ]
    },
