  "incidents": [
    {
      "id": "7w1ccxlcxycr",
      "name": "DEX Platform licensing service. Affected environments are unable to retrieve licensing information,",
      "status": "identified",
      "created_at": "2026-06-27T19:46:03.719+02:00",
      "updated_at": "2026-06-27T23:37:42.820+02:00",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "critical",
      "shortlink": "https://stspg.io/y84ptwfkqk2d",
      "started_at": "2026-06-27T19:46:03.711+02:00",
      "page_id": "gfggtctd0kh2",
      "incident_updates": [
        {
          "id": "bglg5ntdcdh2",
          "status": "identified",
          "body": "We have identified the root cause. The License.dll file that is used to communicate with the Licensing services has an embedded certificate, this certificate expired preventing the Coordinator service from starting.\nOur teams are working on the Hotfix We have resolved the issue with Single tenant SaaS Environments and have a manual fix to resolve On Prem customers prior to the hotfix being released. https://support.1e.com/portal/6/CUSTSUP/article/2668298242/Users%20are%20unable%20to%20login%20the%20Platform%20UI%20and%20the%20coordinator%20server%20will%20not%20start.\nFurther updates will be provided 28/6/26 @10am",
          "incident_id": "7w1ccxlcxycr",
          "created_at": "2026-06-27T23:37:42.817+02:00",
          "updated_at": "2026-06-27T23:37:42.817+02:00",
          "display_at": "2026-06-27T23:37:42.817+02:00",
          "affected_components": [
            {
              "code": "0g1qf1117q2j",
              "name": "DEX Platform and Solutions - DEX On Premises Platform Updates",
              "old_status": "major_outage",
              "new_status": "major_outage"
            }
          ],
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "c8rn5n4jlxr6",
          "status": "identified",
          "body": "We have identified the issue and teams are working towards a fix.",
          "incident_id": "7w1ccxlcxycr",
          "created_at": "2026-06-27T21:10:02.079+02:00",
          "updated_at": "2026-06-27T21:10:02.079+02:00",
          "display_at": "2026-06-27T21:10:02.079+02:00",
          "affected_components": [
            {
              "code": "0g1qf1117q2j",
              "name": "DEX Platform and Solutions - DEX On Premises Platform Updates",
              "old_status": "major_outage",
              "new_status": "major_outage"
            }
          ],
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "t03qqq0klw50",
          "status": "investigating",
          "body": "We are investigating an issue affecting the DEX Platform licensing service. Affected environments are unable to retrieve licensing information, which prevents instructions from being executed on the platform and/or preventing access.\n\nImpact\n\nSingle Tenancy and On-Premises environments are affected\n\nUsers see the error: \"Licence Error The system in unable to retrieve it's license information\" when trying to log in\n\nInfrastructure logs show: VerifyActivationSignature: failed(3)\n\nIf users are already in the platform Instruction execution is unavailable will be presented with Error Cannot retrieve licensing information. Please see log for details.\n\nClient connectivity is not affected\n\n\n\nCurrent Status\nOur engineering and support teams are actively investigating the root cause. An out-of-hours escalation has been triggered and the cloud engineering team has been engaged. We are working towards a resolution and will provide updates every two hours.\n\nNext Update\nWe will provide the next update by 20:00 UTC on 27 June 2026.",
          "incident_id": "7w1ccxlcxycr",
          "created_at": "2026-06-27T19:46:03.787+02:00",
          "updated_at": "2026-06-27T19:46:03.787+02:00",
          "display_at": "2026-06-27T19:46:03.787+02:00",
          "affected_components": [
