          "updated_at": "2026-03-14T16:10:35Z"
        },
        {
          "id": "01KKM9AAEF156237RDYTDD0WS6",
          "body": "Our systems are continuing to work through the backlog. Data will update throughout the day as the backlog clears. We expect most of the backlog to clear today and all data sources to be caught up within the next 24 hours.",
          "created_at": "2026-03-13T19:03:35Z",
          "display_at": "2026-03-13T19:03:35Z",
          "incident_id": "01KKKKE6Y2N8NG9K4SPH09YJ3B",
          "status": "identified",
          "updated_at": "2026-03-13T19:03:35Z"
        },
        {
          "id": "01KKKTG4G5Z6CED3XEGXCY3WHZ",
          "body": "We have identified and resolved the root cause of the data ingestion delays. Our systems are now processing the backlog of data.\n\nWe will provide another update once we have an estimated time for all data to be fully caught up.",
          "created_at": "2026-03-13T14:44:37Z",
          "display_at": "2026-03-13T14:44:37Z",
          "incident_id": "01KKKKE6Y2N8NG9K4SPH09YJ3B",
          "status": "identified",
          "updated_at": "2026-03-13T14:44:37Z"
        },
        {
          "id": "01KKKKE6Y2GG5YRDYX7J91DCH3",
          "body": "We are currently investigating an issue affecting data ingestion. As a result, some customers may experience delays or missing data for activity from March 12th onward.\n\nOur team is actively working to resolve this issue. Ingested data will backfill automatically once the issue is resolved - no action is required on your part.\n\nWe will provide updates as we have more information.",
          "created_at": "2026-03-13T12:41:14Z",
          "display_at": "2026-03-13T12:41:14Z",
          "incident_id": "01KKKKE6Y2N8NG9K4SPH09YJ3B",
          "status": "investigating",
          "updated_at": "2026-03-13T12:41:14Z"
        }
      ]
    },
