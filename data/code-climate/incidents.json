      "incident_updates": [
        {
          "id": "01KKPHT90EHETT82K98176PVTK",
          "body": "All of the delayed ingestion jobs have been processed and the system is now fully functional.",
          "created_at": "2026-03-14T16:10:35Z",
          "display_at": "2026-03-14T16:10:35Z",
          "incident_id": "01KKKKE6Y2N8NG9K4SPH09YJ3B",
