    {
      "id": "v65248gt8jlm",
      "name": "React App Builder Sandbox Installs May Fail to Install Dependencies",
      "status": "identified",
      "created_at": "2026-08-20T17:26:33.088Z",
      "updated_at": "2026-08-20T18:16:47.003Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "major",
      "shortlink": "https://stspg.io/hfvc3zn0ct60",
      "started_at": "2026-08-20T17:26:33.081Z",
      "page_id": "0qnsgqt7vsht",
      "incident_updates": [
        {
          "id": "s9mnltyrswjk",
          "status": "identified",
          "body": "This issue affects Retool version 4.0.0+ (stable and edge), specifically for 1) newly-created React apps, 2) new publishes of existing React apps, and 3) cold starts of sandboxes when editing existing React apps.\n\nExisting published apps that do not get published after August 19th are unaffected.\n\nSelf-hosted customers can update to 4.43.0-edge to get an immediate fix. A patch to our stable release channel is coming soon.",
          "incident_id": "v65248gt8jlm",
          "created_at": "2026-08-20T18:16:47.000Z",
          "updated_at": "2026-08-20T18:16:47.000Z",
          "display_at": "2026-08-20T18:16:47.000Z",
