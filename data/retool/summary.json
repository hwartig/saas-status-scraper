        },
        {
          "id": "3dwz2ypqlxyb",
          "status": "identified",
          "body": "In order to protect customer data from a recently disclosed security vulnerability, we've taken Retool Database offline for a very small subset of Retool Cloud organizations hosted on some legacy database infrastructure. Apps and workflows in those organizations that query Retool Database will return errors until it's restored.",
          "incident_id": "hxws9g2jc5tq",
          "created_at": "2026-11-14T00:50:27.020Z",
