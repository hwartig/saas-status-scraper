      "impact": "major",
      "shortlink": "https://stspg.io/g224ckjzhrd6",
      "started_at": "2026-11-16T19:22:13.161-08:00",
      "page_id": "jq64r4cdpggk",
      "incident_updates": [
        {
          "id": "54hdv588mcwb",
          "status": "monitoring",
          "body": "We've implemented an API change to remove an improper configuration option that was creating the lower payload limitation issue. We've confirmed in our testing that error notices are accepted at higher than 8KB limits. Please reach us at support@airbrake.io if you have any questions or concerns. We apologize for the issue.",
          "incident_id": "857v8xglgq9x",
          "created_at": "2026-11-16T19:46:01.285-08:00",
          "updated_at": "2026-11-16T19:46:02.046-08:00",
