      "page_id": "1q8r4n02vb2k",
      "incident_updates": [
        {
          "id": "6lhcp9jbr28c",
          "status": "monitoring",
          "body": "The network outage affecting our ORD data center has been mitigated. Builds running in this data center may have failed or been delayed during the outage window. Our team identified and addressed an issue with Proxmox storage in the affected data center, and job scheduling has resumed. We are continuing to monitor stability as we investigate the underlying root cause.\n\nWe will provide a further update as soon as more information is available.",
          "incident_id": "rnk6slc2xvhm",
          "created_at": "2026-07-14T18:18:19.433Z",
