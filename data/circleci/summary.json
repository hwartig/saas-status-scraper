        {
          "id": "pssjdn3d943w",
          "status": "monitoring",
          "body": "Our Mac infrastructure provider has shifted the inbound routes and we are seeing recovery in VCS fetch times. We will be continuing to monitor this issue over the next few hours. We'll update again soon.",
          "incident_id": "7cnl777wp9qz",
          "created_at": "2026-07-14T16:58:55.916Z",
          "updated_at": "2026-07-14T16:58:55.916Z",
          "display_at": "2026-07-14T16:58:55.916Z",
          "affected_components": [
            {
              "code": "bpfmy8wy8wq2",
