      "incident_updates": [
        {
          "id": "jnmfyjz1c7vt",
          "status": "scheduled",
          "body": "Bitbucket Cloud will perform database maintenance on Saturday, June 13, 2026 from 17:00 to 19:00 UTC. The maintenance will require downtime for all Bitbucket Cloud services including the Bitbucket website, Git operations via SSH and HTTPS, API requests, and Bitbucket Pipelines for the duration of this time (two hours). We encourage all of our users to plan their operations around this window.",
