      "page_id": "bqlf8qjztdtr",
      "incident_updates": [
        {
          "id": "04kfj8gl3lxx",
          "status": "scheduled",
          "body": "Bitbucket will be performing required maintenance on our database infrastructure for 30 minutes on Saturday October 3rd 2026 at 16:00 UTC. The maintenance will require a short period of downtime at the beginning of the maintenance window, affecting all Bitbucket Cloud services including the Bitbucket website, Git operations via SSH and HTTPS, API requests, and Bitbucket Pipelines, and performance degradation is possible throughout the window. We encourage all of our users to plan their operations around this window.",
          "incident_id": "9qrt732qhwn7",
