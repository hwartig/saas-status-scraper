        {
          "id": "vcv6695v5q5q",
          "status": "investigating",
          "body": "We have received the appropriate patch from the vendor and are working to ensure it won't disrupt service to websites and other services. As soon as tests pass and we are confident in the patch and the patch has been successfully applied to shared web hosting, we will re-open the appropriate services.\n\nFor VPS customers, please follow the guidance below to update to the latest version manually.\n\nhttps://docs.cpanel.net/whm/cpanel/upgrade-to-latest-version/",
          "incident_id": "hy20xyjmf81q",
          "created_at": "2026-04-28T21:58:04.876Z",
          "updated_at": "2026-04-28T21:58:04.876Z",
