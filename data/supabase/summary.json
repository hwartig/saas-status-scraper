              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "jyqfnc02f521",
          "status": "identified",
          "body": "We have confirmed that the projects of impacted users remain accessible from regions outside India. \nOur investigation is currently focused on an ISP-level block affecting users within India.\n\nWe advise affected customers to also report the issue to their ISP. Supabase infrastructure remains fully operational.\n\nThe best workaround we have currently is for affected users to use an alternative DNS providers such as:\nCloudflare: https://1.1.1.1\nGoogle https://developers.google.com/speed/public-dns\nQuad9: https://quad9.net/",
          "incident_id": "xmgq69x4brfk",
