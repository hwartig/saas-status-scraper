        },
        {
          "id": "w4cxwmw90xfj",
          "status": "identified",
          "body": "Our engineering team are investigating issues with customer projects being stuck when upgrading Postgres version. \nWe advise that you do not upgrade your project until the incident is resolved.",
          "incident_id": "9nnnmxkfql8k",
