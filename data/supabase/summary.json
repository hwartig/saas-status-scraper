      "id": "xmgq69x4brfk",
      "name": "Users Experiencing Network Connectivity Problems (India Region)",
      "status": "identified",
      "created_at": "2026-02-24T14:46:17.352Z",
      "updated_at": "2026-02-25T18:27:04.996Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "none",
      "shortlink": "https://stspg.io/kcpw1yj9wqzh",
      "started_at": "2026-02-24T14:46:17.342Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "gp46z7p8sk8g",
          "status": "identified",
          "body": "We continue to follow up through all available channels to work with the ISP to resolve this issue.\n\nWe advise affected customers to also report the issue to their ISP and to use an alternative DNS provider as a workaround.\n\nWe will post an updated once the ISP has confirmed that the issue is resolved or additional information becomes available.",
          "incident_id": "xmgq69x4brfk",
          "created_at": "2026-02-25T18:27:04.992Z",
          "updated_at": "2026-02-25T18:27:04.992Z",
          "display_at": "2026-02-25T18:27:04.992Z",
          "affected_components": [
            {
              "code": "mvs609wqrsf7",
