  "incidents": [
    {
      "id": "w91bvbjhqf0f",
      "name": "Intermittent latency in Eastern US",
      "status": "identified",
      "created_at": "2026-09-29T16:26:33.127Z",
      "updated_at": "2026-10-02T21:06:20.555Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "minor",
      "shortlink": "https://stspg.io/gxmmvm5s9rh0",
      "started_at": "2026-09-29T16:26:33.120Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "mjnyxtf6xjt8",
          "status": "identified",
          "body": "While we have observed significant improvement in rates of high latency, we note that some users are still experiencing issues during peak Eastern US business hours. We continue to work with our networking partners to isolate and resolve any lingering sources of high latency. We recognize that this is a longstanding issue and appreciate the patience of affected customers. We will continue to share additional updates here as soon as they are available.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-10-02T21:06:20.553Z",
          "updated_at": "2026-10-02T21:06:20.553Z",
          "display_at": "2026-10-02T21:06:20.553Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dz7fflfkcbb9",
          "status": "identified",
          "body": "Our networking partners have implemented a mitigation to the latency issue at the problematic PoP in the Eastern US, and we have since observed significant improvement in rates of high latency across the region. We are continuing to work with those partners to isolate any additional root causes of latency and improve the reliability of our networking infrastructure across the region.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-10-01T20:23:18.723Z",
          "updated_at": "2026-10-01T20:23:18.723Z",
          "display_at": "2026-10-01T20:23:18.723Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "pt7bl02vy57z",
          "status": "identified",
          "body": "We are seeing signs of improvement and are continuing to work alongside our networking partners towards a resolution.\nWe will provide another update as more information becomes available.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-30T21:26:46.631Z",
          "updated_at": "2026-09-30T21:26:46.631Z",
          "display_at": "2026-09-30T21:26:46.631Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "6n78nkpfp4n9",
          "status": "identified",
          "body": "We're continuing to coordinate with our networking partners to deliver a permanent resolution.\nWe will provide updates as soon as they're available.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-30T14:54:28.877Z",
          "updated_at": "2026-09-30T14:54:28.877Z",
