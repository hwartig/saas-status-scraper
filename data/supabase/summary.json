    {
      "id": "308hm84ntd47",
      "name": "DNS Resolution Failures for TLD .co users",
      "status": "monitoring",
      "created_at": "2026-06-08T03:39:42.327Z",
      "updated_at": "2026-06-12T11:09:44.001Z",
      "monitoring_at": "2026-06-08T06:37:39.739Z",
      "resolved_at": null,
      "impact": "none",
      "shortlink": "https://stspg.io/88tm8x8y9cg1",
      "started_at": "2026-06-08T03:39:42.320Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "rxh07wz78hqp",
          "status": "monitoring",
          "body": "Our upstream TLD provider is continuing to make changes to its network routing policies to address this issue. These changes are intended to improve regional traffic routing and reduce DNS resolution failures.\n\nWe have already begun to see improvements as these changes take effect, but the issue has not yet been fully resolved. We are continuing to monitor the situation closely and work with the provider toward a complete resolution.\n\nWe will provide another update as soon as more information becomes available.",
          "incident_id": "308hm84ntd47",
          "created_at": "2026-06-12T11:09:43.998Z",
          "updated_at": "2026-06-12T11:09:43.998Z",
          "display_at": "2026-06-12T11:09:43.998Z",
          "affected_components": null,
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "c8n8m8h49k0s",
          "status": "monitoring",
          "body": "Our upstream TLD provider believes they have identified the underlying issue, and we are continuing to coordinate with them to review their findings and potential remediation options. In parallel, we are investigating other factors that may be contributing to the ongoing resolution problems affecting a subset of customers. \n\nVPNs continue to provide a workaround for impacted end users while our investigation remains ongoing.",
          "incident_id": "308hm84ntd47",
          "created_at": "2026-06-10T23:24:04.425Z",
          "updated_at": "2026-06-10T23:24:04.425Z",
