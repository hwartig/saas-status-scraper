    {
      "id": "3tx3nnmbwyh9",
      "name": "Project status change failures in multiple regions",
      "status": "identified",
      "created_at": "2026-06-30T02:38:13.608Z",
      "updated_at": "2026-06-30T18:58:41.280Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "major",
      "shortlink": "https://stspg.io/v2kqtvng9qnt",
      "started_at": "2026-06-30T02:38:13.598Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "qkvfkjh4q52p",
          "status": "identified",
          "body": "We are continuing to investigate the remaining capacity constraints affecting ap-northeast-2, ap-south-1, and eu-north-1. Project operations that require capacity in these regions may continue to fail. We will provide another update as soon as more information is available.",
          "incident_id": "3tx3nnmbwyh9",
          "created_at": "2026-06-30T18:58:41.275Z",
          "updated_at": "2026-06-30T18:58:41.275Z",
          "display_at": "2026-06-30T18:58:41.275Z",
          "affected_components": null,
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "8s35t1jq6jgc",
          "status": "identified",
          "body": "Additional capacity has been made available in the majority of regions, and we're seeing reduced failure rates in terms of project creation, project resizing, branch provisioning, and project restarts.\nWe are still experiencing limited instance capacity in ap-northeast-2, ap-south-1, and eu-north-1. \nAs a result, project operations that require capacity in these regions, including project creation, resizing, branch provisioning, restarts, may continue to fail.\nWe are actively working to restore full capacity and will provide another update as soon as more information is available.",
          "incident_id": "3tx3nnmbwyh9",
          "created_at": "2026-06-30T11:20:04.037Z",
          "updated_at": "2026-06-30T11:20:04.037Z",
