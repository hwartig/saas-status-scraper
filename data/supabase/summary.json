          "tweet_id": null
        },
        {
          "id": "8pnmh7hg8ygh",
          "status": "identified",
          "body": "We continue to work with the service provider to resolve the residual access issues. We have scheduled direct consultations with the provider to attempt to resolve the issue.",
          "incident_id": "byfbl0lj2cc3",
          "created_at": "2026-06-03T21:32:04.946Z",
          "updated_at": "2026-06-03T21:32:04.946Z",
