  "incidents": [
    {
      "id": "w91bvbjhqf0f",
      "name": "Intermittent latency in Eastern US",
      "status": "identified",
      "created_at": "2026-09-29T16:26:33.127Z",
      "updated_at": "2026-09-30T02:14:25.395Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "minor",
      "shortlink": "https://stspg.io/gxmmvm5s9rh0",
      "started_at": "2026-09-29T16:26:33.120Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "hdl7s56w7p3q",
          "status": "identified",
          "body": "We are working with our networking partners on a permanent fix.\n\nWhile we do not have an estimated resolution time, we will share updates here as they become available.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-30T02:14:25.392Z",
          "updated_at": "2026-09-30T02:14:25.392Z",
          "display_at": "2026-09-30T02:14:25.392Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dfpztgl1fgt6",
          "status": "identified",
          "body": "A mitigation for this issue was applied earlier today, but we do not have sufficient evidence to conclude that the mitigation resulted in improvement to this eastern US latency issue. We have tied the issue to a particular PoP, and we are continuing to work with our networking partners to bring this issue to a final resolution. We will provide another update within 4 hours, if not before. We appreciate your patience.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-29T21:35:08.081Z",
          "updated_at": "2026-09-29T21:35:08.081Z",
          "display_at": "2026-09-29T21:35:08.081Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "glxfmr3gmbv5",
          "status": "identified",
          "body": "We are continuing our work to fix this latency issue, which has been observed to impact clients connecting to Supabase Projects from the eastern United States. These clients may include servers and serverless functions located in that geographical region, regardless of the region in which the Project is hosted.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-29T17:55:49.052Z",
          "updated_at": "2026-09-29T18:24:47.879Z",
          "display_at": "2026-09-29T17:55:49.000Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "2dls0r94l3ph",
          "status": "identified",
          "body": "We have identified an issue with increased latency for clients in the eastern US during spikes caused by bursty traffic. This is most noticeable during EDT working hours around the :00 and :30 hour marks.\n\nWe are actively working on a fix. We will provide updates as the fix is implemented.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-29T16:26:33.190Z",
          "updated_at": "2026-09-29T16:26:33.190Z",
          "display_at": "2026-09-29T16:26:33.190Z",
          "affected_components": [
