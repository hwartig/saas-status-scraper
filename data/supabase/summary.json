  "incidents": [
    {
      "id": "9nnnmxkfql8k",
      "name": "Customer Projects Experiencing Upgrade Issues",
      "status": "monitoring",
      "created_at": "2026-05-08T13:25:42.200Z",
      "updated_at": "2026-05-08T14:39:35.731Z",
      "monitoring_at": "2026-05-08T14:39:35.716Z",
      "resolved_at": null,
      "impact": "minor",
      "shortlink": "https://stspg.io/2g4rrnjjw8cq",
      "started_at": "2026-05-08T13:25:42.190Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "tlb346dzfkl0",
          "status": "monitoring",
          "body": "We have identified the root cause and developed a fix, which has been applied in production. \nProjects which have failed to upgrade will be automatically recovered and returned to ACTIVE_HEALTHY without manual intervention. \nAny future upgrades should complete successfully. \nWe are continuing to monitor recovery and system stability closely.",
          "incident_id": "9nnnmxkfql8k",
          "created_at": "2026-05-08T14:39:35.716Z",
          "updated_at": "2026-05-08T14:39:35.716Z",
          "display_at": "2026-05-08T14:39:35.716Z",
          "affected_components": null,
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "c899713y3ylq",
          "status": "identified",
          "body": "We are continuing to investigate issues impacting project upgrades.\nWe have observed that the majority of affected projects are successfully returning to a healthy state on their previous PostgreSQL version following failed upgrade attempts. Our engineering team is actively working to manually restore the remaining projects that are still stuck during the upgrade process.\nAs a precaution, we recommend that customers do not attempt to upgrade their projects until this incident has been fully resolved.\nWe will continue to provide updates as information becomes available.",
          "incident_id": "9nnnmxkfql8k",
          "created_at": "2026-05-08T13:46:23.294Z",
          "updated_at": "2026-05-08T13:46:23.294Z",
          "display_at": "2026-05-08T13:46:23.294Z",
          "affected_components": null,
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
