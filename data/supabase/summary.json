              "new_status": "operational"
            },
            {
              "code": "fznyj00kpng2",
              "name": "Auth",
              "old_status": "operational",
              "new_status": "operational"
            },
            {
              "code": "prrc7382xy5j",
              "name": "Compute capacity - ap-south-1",
              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dg623hz0kzwr",
          "status": "identified",
          "body": "We understand many users in India continue to be blocked from accessing Supabase. We acknowledge the difficulties this is causing for our users there. Supabase continues to follow up through all available channels to resolve this issue.\n\nWe continue to advise affected customers to use an alternative DNS provider or a VPN as a workaround in the interim. For some customers, custom domains may also be a viable solution. If you have any questions regarding these options, please contact Supabase support.\n\nWe will post an update once the issue is resolved or additional information becomes available.",
          "incident_id": "xmgq69x4brfk",
          "created_at": "2026-02-27T17:39:49.136Z",
          "updated_at": "2026-02-27T17:39:49.136Z",
          "display_at": "2026-02-27T17:39:49.136Z",
          "affected_components": [
            {
              "code": "mvs609wqrsf7",
              "name": "Edge Functions",
              "old_status": "operational",
              "new_status": "operational"
            },
            {
              "code": "fznyj00kpng2",
              "name": "Auth",
              "old_status": "operational",
              "new_status": "operational"
            },
            {
              "code": "prrc7382xy5j",
              "name": "Compute capacity - ap-south-1",
              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "mm4nf7t90fxm",
          "status": "identified",
          "body": "Affected customers who are using the Custom Domain feature may be able to restore connectivity by switching their Custom Domain's DNS to an alternative DNS and enabling proxying.\n\nWe advise affected customers to continue to report the issue to their ISP.",
          "incident_id": "xmgq69x4brfk",
          "created_at": "2026-02-26T23:36:54.343Z",
          "updated_at": "2026-02-26T23:36:54.343Z",
