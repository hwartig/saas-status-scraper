  "incidents": [
    {
      "id": "6q5902p2xd9f",
      "name": "401 errors due to JWT rejections",
      "status": "identified",
      "created_at": "2026-08-14T02:23:18.370Z",
      "updated_at": "2026-08-31T19:52:53.205Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "minor",
      "shortlink": "https://stspg.io/18v97b9scdh2",
      "started_at": "2026-08-14T02:23:18.361Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "4b9jnybg1nt2",
          "status": "identified",
          "body": "We have seen reports that the JWT rejection issue persisted with 14.17, and due to <a href=\"https://status.supabase.com/incidents/bv4ntm4x0btf\">some unintended performance side effects</a>, we have rolled back to Postgrest 14.5. The team continues to investigate the JWT issue and hopes to have a solution soon.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-31T19:52:53.202Z",
          "updated_at": "2026-08-31T19:52:53.202Z",
          "display_at": "2026-08-31T19:52:53.202Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "s8vsk7zfy0qd",
          "status": "identified",
          "body": "We continue to monitor the fixes introduced by this latest rollout. If you are continuing to see these errors, some customers have reported that restarting their project after the rollout resolved this issue.\n\nTo restart your project, go to the General settings page in the dashboard and select Restart project. \n\nPlease contact our support team if the issue persists after a restart.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-28T23:44:41.276Z",
          "updated_at": "2026-08-28T23:44:41.276Z",
          "display_at": "2026-08-28T23:44:41.276Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "3cczxthx2cb5",
          "status": "identified",
          "body": "PostgREST 14.17 has now been rolled out to all regions. \nSome customers have reported that restarting their project after the rollout resolved this issue.\nTo restart your project, go to the General settings page in the dashboard and select Restart project. \nPlease contact our support team if the issue persists after a restart.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-27T17:17:54.328Z",
          "updated_at": "2026-08-27T17:17:54.328Z",
          "display_at": "2026-08-27T17:17:54.328Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "5fzzjyy27c8d",
          "status": "identified",
          "body": "We are continuing to rollout the fixes for intermittent HTTP 401 errors. In most cases, waiting and refreshing is successful. \n\nThis fix has been applied to the following regions: \nap-east-1\nap-northeast-1\nap-northeast-2\nap-south-1\nap-southeast-1\nap-southeast-2\nca-central-1\neu-central-1\neu-central-2\neu-north-1\neu-west-2\neu-west-3\n\nWe will continue rolling out this fix to the remaining regions throughout this week and provide updates as more regions are successful.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-25T18:41:58.565Z",
          "updated_at": "2026-08-25T18:41:58.565Z",
          "display_at": "2026-08-25T18:41:58.565Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "yg72vlf8xr45",
          "status": "identified",
          "body": "We are continuing to test and rollout the fixes for intermittent HTTP 401 errors. In most cases, waiting and refreshing is successful. \n\nWe will monitor eu-central-2 over the weekend and are preparing for the fix to be pushed to all regions starting Monday. Thank you for your patience while we've worked on multiple fixes for this issue.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-21T17:21:47.790Z",
          "updated_at": "2026-08-21T17:21:47.790Z",
          "display_at": "2026-08-21T17:21:47.790Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "pbd82n59vrmt",
          "status": "identified",
          "body": "As part of the incident remediation flow, we have separately identified \"/lib/aarch64-linux-gnu/libc.so.6: version `GLIBC_2.34' not found\" error between 11:15 - 16:24 UTC today affecting PostgREST. This has been fixed and we can see the error rates have subsided.",
          "incident_id": "6q5902p2xd9f",
          "created_at": "2026-08-20T16:37:44.059Z",
          "updated_at": "2026-08-20T16:37:44.059Z",
          "display_at": "2026-08-20T16:37:44.059Z",
          "affected_components": [
            {
              "code": "43453sylqk7v",
              "name": "API Gateway",
              "old_status": "degraded_performance",
              "new_status": "degraded_performance"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dv9z102qxq9v",
          "status": "identified",
          "body": "Fixes for this issue are being sequentially rolled out. The impact of the issue is limited to a subset of new projects that can experience it upon some JWT renewals. We will update the status when all the fix rollouts have completed.",
