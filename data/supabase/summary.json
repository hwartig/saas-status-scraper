    {
      "id": "y8rp6dwjyplw",
      "name": "Upgrade Shared Pooler V1 to V2 for eu-west-2 region",
      "status": "scheduled",
      "created_at": "2026-06-02T00:56:06.761Z",
      "updated_at": "2026-06-02T00:56:06.823Z",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "maintenance",
      "shortlink": "https://stspg.io/d2wvcbslgmbg",
      "started_at": "2026-06-02T00:56:06.754Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "sz2hftdf066g",
          "status": "scheduled",
          "body": "There will be a scheduled maintenance on 2026-06-09 from 13:00-15:00 UTC on the Shared Pooler(V1) for the eu-west-2 region.\n\nThis maintenance upgrades the Shared Pooler to a new version (V2) that provides better scalability and uptime.\n\nThe Shared Pooler will be unavailable during this time period for anyone connecting to their projects using it. Your projects remain available and connections via the Dedicated Pooler and Direct Connections will continue to work. \n\nHow to determine whether you are affected:\n\nOnly projects connecting to V1 of the Shared Pooler are affected. If your connection string has the format:\n\naws-0-eu-west-2-pooler.supabase.com, you can expect to see errors during the maintenance.\n\nThose using connection strings with the format: aws-1-eu-west-2.pooler.supabase.com are not affected by this maintenance.\n\nPlease follow the status page for updates.",
          "incident_id": "y8rp6dwjyplw",
          "created_at": "2026-06-02T00:56:06.820Z",
          "updated_at": "2026-06-02T00:56:06.820Z",
          "display_at": "2026-06-02T00:56:06.820Z",
          "affected_components": [
            {
              "code": "022jctfqtj3y",
              "name": "Connection Pooler",
              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        }
