          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dmflyfgjtvj4",
          "status": "monitoring",
          "body": "The third-party has confirmed a fix has been implemented and we are validating the results with our impacted users.",
          "incident_id": "308hm84ntd47",
