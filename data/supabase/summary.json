    {
      "id": "xmg8tmj6lsk4",
      "name": "Projects in stuck state in EU-CENTRAL-1 (Frankfurt)",
      "status": "monitoring",
      "created_at": "2026-07-16T07:00:12.335Z",
      "updated_at": "2026-07-16T10:14:13.689Z",
      "monitoring_at": "2026-07-16T10:14:13.672Z",
      "resolved_at": null,
      "impact": "major",
      "shortlink": "https://stspg.io/qtq3dlkph9hd",
      "started_at": "2026-07-16T07:00:12.328Z",
      "page_id": "q7pxfmcf2sbx",
      "incident_updates": [
        {
          "id": "4vn7v1pjlmjb",
          "status": "monitoring",
          "body": "All impacted projects have now been successfully restarted, and functionality has been restored.\nWe are moving this incident to Monitoring for an additional hour while we continue to ensure stability.\nIf you believe your project in eu-central-1 (Frankfurt) is still impacted by this issue, please open a support ticket and we'll work with you directly to investigate.",
          "incident_id": "xmg8tmj6lsk4",
          "created_at": "2026-07-16T10:14:13.672Z",
          "updated_at": "2026-07-16T10:14:13.672Z",
          "display_at": "2026-07-16T10:14:13.672Z",
          "affected_components": null,
          "deliver_notifications": false,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "dt48pqr9xd5p",
          "status": "identified",
          "body": "The majority of impacted projects have now been recovered, and functionality has been restored for most customers.\nOur team continues to work through the remaining affected projects individually to restore normal functionality as quickly as possible.\nWe will continue to provide updates as this work progresses.",
          "incident_id": "xmg8tmj6lsk4",
