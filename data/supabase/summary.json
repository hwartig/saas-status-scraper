              "old_status": "operational",
              "new_status": "operational"
            }
          ],
          "deliver_notifications": true,
          "custom_tweet": null,
          "tweet_id": null
        },
        {
          "id": "hdl7s56w7p3q",
          "status": "identified",
          "body": "We are working with our networking partners on a permanent fix.\n\nWhile we do not have an estimated resolution time, we will share updates here as they become available.",
          "incident_id": "w91bvbjhqf0f",
          "created_at": "2026-09-30T02:14:25.392Z",
          "updated_at": "2026-09-30T02:14:25.392Z",
