    {
      "id": "rqyxpwwkwtt4",
      "name": "SendGrid Status Page Migration to Twilio Status Page — July 29, 2026",
      "status": "scheduled",
      "created_at": "2026-07-09T05:10:20.732-07:00",
      "updated_at": "2026-07-14T22:24:39.119-07:00",
      "monitoring_at": null,
      "resolved_at": null,
      "impact": "maintenance",
      "shortlink": "https://stspg.io/ng6xjr6ypyjv",
      "started_at": "2026-07-09T05:10:20.694-07:00",
      "page_id": "3tgl2vf85cht",
      "incident_updates": [
        {
          "id": "pdljj6m4xb73",
          "status": "scheduled",
          "body": "On July 29, 2026 at 9:00 AM PT (originally planned for July 22), SendGrid incident and maintenance notifications will move to the Twilio Status Page: https://status.twilio.com.\n\nYour existing SendGrid Status Page subscription will be migrated. Depending on how you currently receive notifications, you may need to confirm your subscription to continue receiving updates.\n\nWhat to expect:\n\nEMAIL SUBSCRIBERS: You should have received a confirmation email from status-help@statuspage.twilio.com on July 13 or 14. You must confirm your subscription via the email to continue receiving updates.\n\nSMS SUBSCRIBERS: You should have received a confirmation email from status-help@statuspage.twilio.com on July 13 or 14. You must confirm your subscription via the message to continue receiving updates.\n\nWEBHOOK SUBSCRIBERS: No action is required. Your webhook subscription will be migrated automatically and will continue to receive notifications without interruption.\n\nPost migration, you will continue to receive notifications for the SendGrid services you are currently subscribed to, delivered from the Twilio Status Page.\n \nThank you for your continued trust in Twilio and SendGrid.",
          "incident_id": "rqyxpwwkwtt4",
          "created_at": "2026-07-09T05:10:20.846-07:00",
          "updated_at": "2026-07-14T22:24:39.114-07:00",
