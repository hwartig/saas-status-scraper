    {
      "id": "01KTRTZFVZKRNTW66N1G5S8Z4M",
      "name": "Login issues",
      "status": "resolved",
      "created_at": "2026-06-10T13:19:05Z",
      "updated_at": "2026-06-10T16:15:39Z",
