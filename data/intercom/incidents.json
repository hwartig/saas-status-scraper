    {
      "id": "01KTV1MRQ5B5FF50BE434VSW48",
      "name": "Mobile SDK endpoints and mobile push impaired in the European and Australian hosting regions",
      "status": "resolved",
      "created_at": "2026-06-11T09:54:03Z",
      "updated_at": "2026-06-11T10:33:39Z",
      "resolved_at": "2026-06-11T10:33:39Z",
      "impact": "major",
      "page_id": "01J0K0GDABNZ5YHF7DWB9QV4PC",
      "incident_updates": [
        {
          "id": "01KTV3X95FX2A8SSS3K24WMDG5",
          "body": "For EU customers between 09:34 - 10:18UTC, and AU customers between 09:36 - 10:06UTC Mobile SDK endpoints and mobile push were impaired. This issue should now be resolved and all services are restored to normal functionality.\n\nPlease don’t hesitate to reach out to [team@intercom.io](mailto:team@intercom.io) if you have any further questions or if you’re still seeing any unexpected behaviour",
          "created_at": "2026-06-11T10:33:39Z",
          "display_at": "2026-06-11T10:33:39Z",
          "incident_id": "01KTV1MRQ5B5FF50BE434VSW48",
          "status": "resolved",
          "updated_at": "2026-06-11T10:34:43Z"
        },
        {
          "id": "01KTV1MRQ5RCTKYWA93HR8GA95",
          "body": "We are investing a high rate of errors in the mobile SDK endpoints and mobile push functionality in the EU and Australian hosting regions.",
          "created_at": "2026-06-11T09:54:03Z",
          "display_at": "2026-06-11T09:54:03Z",
          "incident_id": "01KTV1MRQ5B5FF50BE434VSW48",
          "status": "identified",
          "updated_at": "2026-06-11T09:54:03Z"
        }
