        },
        {
          "id": "01KZ73S8SPHTNMMN53FE5ZRQ4J",
          "body": "We are currently experiencing a partial outage affecting Sourcegraph Cloud instances in us-central1 region. Users may be seeing slow response times, failed requests, or reduced functionality across code search, code intelligence, and Cody.\n\nWe have identified that this incident is related to compute capacity constraints in our Google Cloud Platform infrastructure. We are actively working to mitigate the issue.",
          "created_at": "2026-08-04T19:25:08Z",
          "display_at": "2026-08-04T19:25:08Z",
          "incident_id": "01KZ73S8SP6ZD6XMS47BJCJ3TH",
          "status": "investigating",
          "updated_at": "2026-08-04T19:25:08Z"
        }
      ]
    }
